library(readxl)
library(ChIPpeakAnno)
library(org.Mm.eg.db)
library(dplyr)
library(stringr)
library(WriteXLS)
source("./utils.R")
df_metabolic <- read_xlsx("../../01_20_2024_Marcus_lists/All Metabolic genes.xlsx", skip = 3)
metabolic_symbol <- df_metabolic$`Mouse Symbol`
metabolic_symbol <- metabolic_symbol[!is.na(metabolic_symbol)]
metabolic_symbol <- metabolic_symbol %>%
as.character() %>%
str_to_upper() %>%
.[.!="NA"] %>%
.[.!="-"] %>%
.[.!="NOT FOUND IN DATABASE"] %>%
unique()
metabolic_symbol
# Goal3:
CDKN2A_CRISPR <- read.csv(file = "../../01_20_2024_Marcus_lists/CDKN2A's Top 100 Codependencies for CRISPR (DepMap Public 23Q4+Score Chronos).csv")
head(CDKN2A_CRISPR)
CDKN2A_RNA <- read.csv(file = "../../01_20_2024_Marcus_lists/CDKN2A's Top 100 Codependencies for RNAi (Achilles+DRIVE+Marcotte DEMETER2).csv")
head(CDKN2A_RNA)
CDKN2A_CRISPR$is_in_metabolic <- CDKN2A_CRISPR$Gene %in% metabolic_symbol
head(CDKN2A_CRISPR)
CDKN2A_RNAi <- read.csv(file = "../../01_20_2024_Marcus_lists/CDKN2A's Top 100 Codependencies for RNAi (Achilles+DRIVE+Marcotte DEMETER2).csv")
CDKN2A_RNAi$is_in_metabolic <- CDKN2A_RNAi$Gene %in% metabolic_symbol
WriteXLS(x = CDKN2A_CRISPR, ExcelFileName = "../../../results/results_04_27/Common_genes/common_metabolic_CDKN2A_CRISPR.xlsx")
WriteXLS(x = CDKN2A_RNA, ExcelFileName = "../../../results/results_04_27/Common_genes/common_metabolic_CDKN2A_RNA.xlsx")
CDKN2A_RNAi$is_in_metabolic <- CDKN2A_RNAi$Gene %in% metabolic_symbol
WriteXLS(x = CDKN2A_RNAi, ExcelFileName = "../../../results/results_04_27/Common_genes/common_metabolic_CDKN2A_RNAi.xlsx")
CDKN2A_CRISPR$Gene
str_to_upper(CDKN2A_CRISPR$Gene)
CDKN2A_CRISPR$is_in_metabolic <- str_to_upper(CDKN2A_CRISPR$Gene) %in% metabolic_symbol
CDKN2A_RNAi$is_in_metabolic <- str_to_upper(CDKN2A_RNAi$Gene) %in% metabolic_symbol
WriteXLS(x = CDKN2A_CRISPR, ExcelFileName = "../../../results/results_04_27/Common_genes/common_metabolic_CDKN2A_CRISPR.xlsx")
WriteXLS(x = CDKN2A_RNAi, ExcelFileName = "../../../results/results_04_27/Common_genes/common_metabolic_CDKN2A_RNAi.xlsx")
