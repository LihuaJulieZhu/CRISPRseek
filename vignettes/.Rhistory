with(mtcars, filter(mtcars, rep(1, 32)))
with(mtcars, filter(mtcars, rep(TRUE, 32)))
?subset
mtcars %>% subset(mpg < 15)
# filter is pipable function, while mean is summaziable function.
with(mtcars, summarize(mean_mpg, mean(mpg)))
# filter is pipable function, while mean is summaziable function.
with(mtcars, summarize(mean_mpg = mean(mpg)))
# filter is pipable function, while mean is summaziable function.
with(mtcars, summarize(mean(mpg)))
with(mtcars, filter(mpg < 20))
# Does not work: with(mtcars, filter(mpg < 20))
